{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "methods.json",
  "description": "Produced by Claude each iteration. Method metadata is resolved from method_registry.json; the list may contain fewer entries than the measured budget when no safe method is eligible.",
  "type": "object",
  "required": ["iter", "methods"],
  "properties": {
    "iter": { "type": "integer", "minimum": 1 },
    "archetype": { "type": "string" },
    "numerics_mode": { "type": "string", "enum": ["reference", "strict", "approximate"] },
    "unfilled_budget": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "methods": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier from references/optimization_catalog.md, e.g. 'compute.tensor_core'"
          },
          "name": {
            "type": "string",
            "description": "Short human-friendly label"
          },
          "axis": {
            "type": "string",
            "enum": ["compute", "memory", "latency"]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 22,
            "description": "Optional compatibility field; canonical value is resolved from method_registry.json."
          },
          "skipped_higher": {
            "type": "array",
            "description": "List of higher-priority methods that were skipped on this axis, with reasons",
            "items": {
              "type": "object",
              "required": ["id", "priority", "reason"],
              "properties": {
                "id": { "type": "string" },
                "priority": { "type": "integer" },
              "reason": { "type": "string", "enum": ["already_selected", "arch_incompatible", "feature_unavailable", "toolchain_incompatible", "skip_condition", "no_trigger", "insufficient_evidence"] }
              }
            }
          },
          "description": {
            "type": "string",
            "description": "One-paragraph concrete description of what changed from best_file"
          },
          "ncu_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["metric", "value"],
              "properties": {
                "metric": { "type": "string" },
                "value": { "type": "number" },
                "unit": { "type": "string" }
              }
            }
          },
          "trigger_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Continuous trigger strength (0-1) for same-axis multi-method ranking. Only required when axis budget >= 2."
          },
          "expected_metric_shift": {
            "type": "string",
            "description": "What ncu changes we expect on the new kernel"
          }
          ,"evidence": {
            "type": "array",
            "items": { "type": "object", "required": ["kind", "status"], "properties": {
              "kind": { "type": "string" }, "status": { "type": "string", "enum": ["pass", "fail", "inconclusive", "missing"] }, "detail": { "type": "string" }
            } }
          },
          "semantic_policy": { "type": "string" }
        }
      }
    }
  }
}
