{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "methods.json",
  "description": "1..3 evidence-driven methods; per-axis cap 2; budget is advisory",
  "type": "object",
  "required": [
    "iter",
    "methods"
  ],
  "properties": {
    "iter": {
      "type": "integer",
      "minimum": 1
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "axis",
          "priority",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier from references/optimization_catalog.md, e.g. 'compute.mmac_tensor_core'"
          },
          "name": {
            "type": "string",
            "description": "Short human-friendly label"
          },
          "axis": {
            "type": "string",
            "enum": [
              "compute",
              "memory",
              "latency"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Priority level from the catalog (P1=1, P2=2, ...). Lower is higher priority."
          },
          "skipped_higher": {
            "type": "array",
            "description": "List of higher-priority methods that were skipped on this axis, with reasons",
            "items": {
              "type": "object",
              "required": [
                "id",
                "priority",
                "reason"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "priority": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string",
                  "description": "Why this higher-priority method was skipped: 'already_selected' | 'arch_incompatible' | 'feature_unavailable' | 'skip_condition' | 'no_trigger'"
                }
              }
            }
          },
          "description": {
            "type": "string",
            "description": "One-paragraph concrete description of what changed from best_file"
          },
          "dcu_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "metric",
                "value"
              ],
              "properties": {
                "metric": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                }
              }
            }
          },
          "trigger_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Continuous trigger strength (0-1) for same-axis multi-method ranking. Only required when axis budget >= 2."
          },
          "expected_metric_shift": {
            "type": "string",
            "description": "Expected changes in the selected tool's metrics/timeline or target ISA; name XProf/XCompute or hipprof explicitly and preserve its definitions"
          },
          "target_evidence": {
            "type": "string"
          },
          "retry_reason": {
            "type": "string"
          }
        }
      }
    },
    "coupling_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ids",
          "separate_deltas",
          "validation_plan"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "separate_deltas": {
            "type": "string",
            "minLength": 1
          },
          "validation_plan": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
